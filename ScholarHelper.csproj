<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <Version>0.3.0.0</Version>
    <Author>Seris</Author>
    <Name>Scholar Helper</Name>
    <InternalName>ScholarHelper</InternalName>
    <Punchline>Scholar cooldown glows and party alerts.</Punchline>
    <Description>Personal FFXIV Scholar plugin for raiding. Uses the game's built-in hotbar proc glow for cooldowns and fairy reminders, plus simple party alerts and hover range tooltips.</Description>
    <RepoUrl>https://github.com/serisly/ScholarHelper</RepoUrl>
    <IconUrl>https://raw.githubusercontent.com/serisly/ScholarHelper/main/images/icon.png</IconUrl>
    <Tags>scholar;healer;hotbar;cooldown;utility</Tags>
    <ApplicableVersion>any</ApplicableVersion>
    <DalamudApiLevel>15</DalamudApiLevel>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputPath>bin\x64\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="images\icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
